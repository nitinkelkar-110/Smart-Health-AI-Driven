# MediGrid AI — Secure Backend Server Environment
# All external AI provider keys are kept securely on the server side
# and are NEVER exposed to the frontend browser or client bundles.

PORT=3001
NODE_ENV=development

# Google Gemini API Key (Server-Side Only)
GEMINI_API_KEY=

# Groq Cloud API Key (Server-Side Only)
GROQ_API_KEY=

# OpenRouter API Key (Server-Side Only)
OPENROUTER_API_KEY=

# Local Ollama Inference (Optional Local Daemon)
OLLAMA_BASE_URL=http://localhost:11434

# Supabase / PostgreSQL Credentials (Server-Side Connection)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
